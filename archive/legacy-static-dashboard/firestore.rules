rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read/write access to the "trips" collection
    // Note: Since you do not use Firebase Auth, this is open to everyone.
    match /trips/{document=**} {
      allow read, write: if true;
    }
    
    // Also allow access to the old "inferred_lanes" collection just in case
    match /inferred_lanes/{document=**} {
      allow read, write: if true;
    }
  }
}
